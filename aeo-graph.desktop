[Desktop Entry]
Version=1.0
Type=Application
Name=AEO Graph Studio
GenericName=Answer Engine Optimization & Schema.org Workstation
Comment=Zero-Dependency Answer Engine Optimization, Schema.org Knowledge Graph, llms.txt & AI Bot Shield
Exec=/usr/local/bin/aeo desktop
Icon=aeo-graph-engine
Terminal=false
Categories=Development;WebDevelopment;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open AEO Graph CLI
Exec=x-terminal-emulator -e "/usr/local/bin/aeo --help"

[Desktop Action Web]
Name=Open Web UI (Port 8127)
Exec=/usr/local/bin/aeo web
